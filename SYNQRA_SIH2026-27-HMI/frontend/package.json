{
  "name": "fog-orchestrator-hmi-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FOG-ORCHESTRATOR 2.0 Task 1 — HMI frontend (Three-HMI target suite)",
  "scripts": {
    "dev": "vite",
    "dev:truck01": "vite --port 3001 --open /truck01.html",
    "dev:truck02": "vite --port 3002 --open /truck02.html",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "format": "biome format --write src",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
