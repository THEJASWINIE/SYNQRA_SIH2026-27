# Backend configuration. Copy to backend/.env and adjust.
# Never commit .env — no credentials in source (NFR-011).
HMI_HOST=0.0.0.0
HMI_PORT=8000

# Comma-separated list of allowed CORS origins.
# For Vite dev server: http://localhost:5173,http://127.0.0.1:5173
# For Vite preview server (D13): include http://localhost:4173,http://127.0.0.1:4173
# For production deployment: set to authoritative domain(s)
HMI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
