# FOG-ORCHESTRATOR 2.0 — Task 1 HMI
# Copy to .env and adjust. Never commit .env (NFR-011: no credentials in source).
#
# This file is the single documented list of configurable values.
# Backend and frontend each read their own .env; see backend/.env.example and
# frontend/.env.example for the per-side copies.

# --- Backend ---
HMI_HOST=127.0.0.1
HMI_PORT=8000
# Comma-separated origins permitted to call the API (the Vite dev server).
HMI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (Vite requires the VITE_ prefix to expose a value to the client) ---
VITE_API_BASE_URL=http://127.0.0.1:8000
