# Frontend configuration. Copy to frontend/.env and adjust.
# Vite only exposes variables prefixed with VITE_ to client code.
# Never commit .env, and never put a secret in a VITE_ value — it ships to the browser.
VITE_API_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Provider Selection (M12-A)
#
# "mock" (default) — loads authored scenario data via MockDataProvider
# "live"           — consumes live data stream via LiveDataProvider (M12-A)
# ---------------------------------------------------------------------------
VITE_PROVIDER=mock

# Task 2 live endpoint placeholder (pending integration team confirmation — TECH-001)
# VITE_LIVE_WS_URL=ws://127.0.0.1:8000/ws/live

# ---------------------------------------------------------------------------
# DEVELOPMENT PLACEHOLDER — NOT AUTHORITATIVE
#
# HMI-NFR-003 requires stale data to be flagged after a configurable timeout.
# The authoritative specification states NO value for it. Registered as AMB-014
# in requirements/DECISIONS.md — UNRESOLVED.
#
# PAD-G forbids inventing a value, so this ships DELIBERATELY UNSET and no
# default exists anywhere in the code. Leaving it empty is a valid state: the
# HMI then shows a persistent FRESHNESS THRESHOLD NOT CONFIGURED banner, still
# displays data age, and does not evaluate stale classification (M4D-B).
#
# Setting it enables stale classification for LOCAL DEVELOPMENT ONLY. Any value
# you put here is your own, is not authoritative, and must not be quoted as a
# project decision. Resolution is owed by the specification owner.
# ---------------------------------------------------------------------------
VITE_PLACEHOLDER_NFR003_STALE_TIMEOUT_MS=
